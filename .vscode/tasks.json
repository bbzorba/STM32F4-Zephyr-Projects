    "version": "2.0.0",
    "tasks": [
        {
            "label": "build: Intr_Btn_LED_Blink",
            "type": "shell",
            "command": "make build COMPILE_DIR=applications/Intr_Btn_LED_Blink",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "owner": "gcc",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
